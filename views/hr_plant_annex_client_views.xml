<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_plant_annex_client_list_view" model="ir.ui.view">
        <field name="name">hr.plant.annex.client.list</field>
        <field name="model">hr.plant.annex.client</field>
        <field name="arch" type="xml">
            <list string="Clientes Anexo Planta">
                <field name="name"/>
                <field name="clause_html"/>
            </list>
        </field>
    </record>

    <record id="hr_plant_annex_client_form_view" model="ir.ui.view">
        <field name="name">hr.plant.annex.client.form</field>
        <field name="model">hr.plant.annex.client</field>
        <field name="arch" type="xml">
            <form string="Cliente Anexo Planta">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Clausula">
                        <field name="clause_html" widget="html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_plant_annex_client_action" model="ir.actions.act_window">
        <field name="name">Clientes Anexo Planta</field>
        <field name="res_model">hr.plant.annex.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_plant_annex_client"
              name="Clientes Anexo Planta"
              parent="menu_hr_tables_root"
              action="hr_plant_annex_client_action"
              sequence="96"/>
</odoo>
