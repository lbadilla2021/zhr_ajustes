<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_contract_reference_list_view" model="ir.ui.view">
        <field name="name">hr.contract.reference.list</field>
        <field name="model">hr.contract.reference</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reference_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_contract_reference_form_view" model="ir.ui.view">
        <field name="name">hr.contract.reference.form</field>
        <field name="model">hr.contract.reference</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference_type"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_reference_action" model="ir.actions.act_window">
        <field name="name">Referencias de Contrato</field>
        <field name="res_model">hr.contract.reference</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_contract_reference"
              name="Referencias de Contrato"
              parent="menu_hr_tables_root"
              action="hr_contract_reference_action"
              sequence="95"/>
</odoo>
