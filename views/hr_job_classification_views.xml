<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_job_sence_classification_list_view" model="ir.ui.view">
        <field name="name">hr.job.sence.classification.list</field>
        <field name="model">hr.job.sence.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_job_sence_classification_form_view" model="ir.ui.view">
        <field name="name">hr.job.sence.classification.form</field>
        <field name="model">hr.job.sence.classification</field>
        <field name="arch" type="xml">
            <form string="Clasificación Sence">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_job_sence_classification_action" model="ir.actions.act_window">
        <field name="name">Clasificación Sence</field>
        <field name="res_model">hr.job.sence.classification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_hr_job_sence_classification"
              name="Clasificación Sence"
              parent="menu_hr_tables_root"
              action="hr_job_sence_classification_action"
              sequence="82"/>

