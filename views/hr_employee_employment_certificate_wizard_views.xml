<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_employment_certificate_wizard_view" model="ir.ui.view">
        <field name="name">hr.employee.employment.certificate.wizard.form</field>
        <field name="model">hr.employee.employment.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Certificado Laboral">
                <group>
                    <field name="employee_id"/>
                    <field name="presentation_place"
                           placeholder="Ej.: Banco de Chile"/>
                    <field name="additional_clause"
                           placeholder="Escriba aquí el texto adicional que desea incluir..."/>
                </group>
                <footer>
                    <button string="Imprimir"
                            type="object"
                            name="action_print"
                            icon="fa-print"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
