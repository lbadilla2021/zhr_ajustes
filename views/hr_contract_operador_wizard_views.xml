<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_contract_operador_wizard_view" model="ir.ui.view">
        <field name="name">hr.contract.operador.wizard.form</field>
        <field name="model">hr.contract.operador.wizard</field>
        <field name="arch" type="xml">
            <form string="Tipo de contrato operador">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="contract_type" widget="radio"/>
                    <field name="faena_text" invisible="contract_type != 'faena'" required="contract_type == 'faena'"/>
                </group>
                <footer>
                    <button string="Imprimir" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
