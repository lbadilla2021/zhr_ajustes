<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_contract_plant_annex_wizard_view" model="ir.ui.view">
        <field name="name">hr.contract.plant.annex.wizard.form</field>
        <field name="model">hr.contract.plant.annex.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir Anexo Planta">
                <group>
                    <field name="contract_id"/>
                    <field name="client_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button string="Imprimir"
                            type="object"
                            name="action_print"
                            icon="fa-print"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
