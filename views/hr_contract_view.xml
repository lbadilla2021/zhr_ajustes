<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_contract_form_inherit_print" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.print</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <!-- Agregamos el botón en la cabecera -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_contract"
                    type="object"
                    string="Contrato"
                    icon="fa-print"
                    class="btn-primary btn-sm"
                    help="Imprime el contrato de trabajo del empleado"
                />
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_print_anexo_planta"
                    type="object"
                    string="Anexo Planta"
                    icon="fa-print"
                    class="btn-secondary btn-sm"
                    help="Imprime el anexo de planta del trabajador"
                />
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_print_pacto_he"
                    type="object"
                    string="Pacto HE"
                    icon="fa-print"
                    class="btn-secondary btn-sm"
                    help="Imprime el pacto de horas extraordinarias"/>
             </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_print_actualizacion"
                    type="object"
                    string="Actualización"
                    icon="fa-print"
                    class="btn-secondary btn-sm"
                    groups="hr.group_hr_user"
                    help="Imprime actualización de contrato"/>
            </xpath>

            <xpath expr="//button[@name='action_print_actualizacion']" position="after">
                <button
                    name="action_open_duplicate_wizard"
                    type="object"
                    icon="fa-plus"
                    class="btn-secondary btn-sm"
                    groups="hr.group_hr_user"
                    help="Duplica el contrato actual con nueva fecha de inicio y referencia"/>
            </xpath>

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,open,close,expired,cancel</attribute>
                <attribute name="statusbar_colors">{'expired': 'gray', 'cancel': 'gray'}</attribute>
            </xpath>

            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="can_edit_fecha_contrato" invisible="1"/>
                <field name="is_indefinite_contract" invisible="1"/>
                <field name="reference_id"
                       required="1"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="fecha_contrato"
                       readonly="not can_edit_fecha_contrato"/>
                <field name="fecha_finiquito"
                       readonly="is_indefinite_contract"/>
            </xpath>

            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="string">Fecha inicio de vigencia</attribute>
            </xpath>

            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="string">Fecha de finalización vigencia</attribute>
            </xpath>

            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="readonly">is_indefinite_contract</attribute>
            </xpath>

            <xpath expr="//field[@name='wage']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='wage']" position="after">
                <field name="wage_positive_check"
                       class="zhr_wage_positive_check"
                       required="wage &lt;= 0"
                       invisible="wage &gt; 0"/>
            </xpath>

            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="is_por_obra" invisible="1"/>
                <field name="departure_reason_id"
                       readonly="1"
                       invisible="not fecha_finiquito"/>
                <field name="tipo_obra_id" invisible="not is_por_obra" required="is_por_obra"/>
                <field name="duracion_obra" invisible="not is_por_obra" required="is_por_obra"/>
            </xpath>

            <xpath expr="//field[@name='contract_type_id']/.." position="after">
                <field name="employee_payment_concept_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="payment_concept_id"/>
                        <field name="amount"/>
                    </list>
                </field>
            </xpath>

            <xpath expr="//div[@id='resource_calendar_warning']" position="after">
                    <field name="lugar_trabajo_id"/>
            </xpath>
        </field>
    </record>

    <record id="hr_contract_list_inherit_identification" model="ir.ui.view">
        <field name="name">hr.contract.list.inherit.identification</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="identification_id"
                       string="Numero de Identificacion"
                       readonly="1"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="before">
                <field name="fecha_contrato"
                       string="Fecha Contrato"
                       optional="show"/>
                <field name="fecha_finiquito"
                       string="Fecha Termino"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="string">Fecha inicio de vigencia</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="string">Fecha de finalización vigencia</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state"
                       widget="badge"
                       class="zhr_contract_state_badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'open'"
                       decoration-warning="state == 'close'"
                       decoration-muted="state == 'expired' or state == 'cancel'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
