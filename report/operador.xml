<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_contract_employee_operador" model="ir.actions.report">
        <field name="name">Contrato Empleado Operador</field>
        <field name="model">hr.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="zhr_ajustes.paperformat_contrato"/>
        <field name="report_name">zhr_ajustes.contract_employee_template_operador</field>
        <field name="report_file">zhr_ajustes.contract_employee_template_operador</field>
        <field name="print_report_name">'Contrato Operador - %s' % (object.name)</field>
    </record>

    <template id="contract_employee_template_operador">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="contract">
                <t t-set="company" t-value="contract.company_id"/>
                <t t-set="fecha_pago_config" t-value="env['zhr.fecha.pago'].search([], limit=1)"/>
                <t t-call="web.basic_layout">
                    <div class="page">

                        <p style="text-align:center;">
                            <t t-if="contract.is_por_obra">CONTRATO DE TRABAJO POR OBRA O FAENA</t>
                            <t t-else="">CONTRATO DE TRABAJO</t>
                        </p>

                        <p style="text-align:justify;">
                        En Cabrero, a 
                        <span t-esc="contract.format_date_es(contract.employee_id.first_contract_date)"/>
                        entre <strong><span t-esc="company.name"/>,
                        R.U.T.: <span t-esc="company.vat"/>,</strong>,
                        representada legalmente por <strong>Claudio Barrales Espinoza , RUT 12.702.854-0</strong>
                         con domicilio en Lote 4 Sector la Quinta S/N, Cabrero,
                        y <strong><span t-esc="contract.employee_id.name"/>,
                        R.U.T.: <span t-esc="contract.employee_id.identification_id"/>,</strong>
                        de nacionalidad chilena, fecha nacimiento 
                        <span t-esc="contract.format_date_es(contract.employee_id.birthday)"/>
                        domiciliado en 
                        <span t-esc="contract.employee_id.private_street"/>,
                        de estado civil <span t-esc="contract.employee_id.get_marital_label()"/>,
                        AFP: <span t-esc="contract.employee_id.afp_id.name"/>, 
                        Salud: <span t-esc="contract.employee_id.health_system_id.name"/>,
                        se ha convenido el siguiente Contrato de trabajo, para cuyos efectos las partes convienen en 
                        denominarse, respectivamente,<strong> Empleador y Trabajador.</strong>
                        </p>

                        <p style="margin:0;"><strong>PRIMERO: Cargo del Trabajador</strong></p>
                        <t t-if="contract.lugar_trabajo_id and contract.lugar_trabajo_id.description">
                            <p style="text-align:justify;">
                                El Trabajador se compromete a ejecutar la labor de <strong><span t-esc="contract.job_id.name"/></strong>,
                                o labores similares,
                                <span t-esc="contract.lugar_trabajo_id.description"/>
                            </p>
                        </t>
                        <t t-else="">
                            <p style="text-align:justify;">
                            El Trabajador se compromete a ejecutar la labor de <strong><span t-esc="contract.job_id.name"/></strong>,
                            o labores similares, en instalaciones de <span t-esc="company.name"/>, ubicado en Lote 4 Sector la Quinta, Cabrero pudiendo 
                            ser trasladado a otro domicilio por el ejercicio de sus funciones, dentro de la Región, por causa justificada, 
                            sin que ello importe menoscabo para el trabajador.
                            </p>
                        </t>

                        <p style="margin:0;"><strong>SEGUNDO: Jornada de Trabajo</strong></p>

                        <p style="text-align:justify;">
                        <span t-esc="contract.schedule_details"/>
                        </p>

                        <p style="margin:0;"><strong>TERCERO: Sueldo Base y Asignaciones</strong></p>

                        <p>El Empleador se compromete a remunerar al Trabajador con los siguientes conceptos:</p>

                        <ul>
                            <li>
                                <strong>Sueldo Base:</strong>
                                Valor fijo <span t-esc="(dict(contract._fields['schedule_pay']._description_selection(contract.env)).get(contract.schedule_pay, contract.schedule_pay or '') or '').lower()"/> por la cantidad de
                                <strong>
                                $<span t-esc="'{:,}'.format(int(contract.wage)).replace(',', '.')"/>.-</strong>
                                <span>
                                (<span t-esc="contract.wage_text"/>s)
                                </span>
                            </li>
                            <li style="text-align:justify;">
                            <strong>Gratificación:</strong>
                            El<b> Empleador</b> pagará al<b> Trabajador</b> por concepto de<b> Gratificación</b> el monto establecido en el artículo 50 
                            del Código del Trabajo, esto es, el 25% (veinticinco por ciento) de lo devengado en el respectivo ejercicio 
                            comercial por concepto de remuneraciones mensuales, entendiéndose con ello que para todos los efectos legales 
                            queda eximido de la obligación establecida en el artículo 47 del Código del Trabajo, sea cual fuere la utilidad líquida que obtuviere. 
                            El monto a pagar por este concepto no excederá en total de 4,75 Ingresos Mínimos Mensuales.
                            </li>

                            <t t-foreach="contract.employee_payment_concept_ids" t-as="line">
                                <t t-if="line.payment_concept_id.name == 'Bonos Localidad'">
                                    <li><strong>Bono Localidad:</strong>
                                    Valor bruto diario por realizar labores en las siguientes localidades:
                                    </li>

                                    <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                                        <tr style="border:1px solid black;">
                                            <th style="border:1px solid black; padding:5px;">Localidad</th>
                                            <th style="border:1px solid black; padding:5px;">Valor Bruto Diario</th>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                            Oficinas Centrales Cabrero / Planta Placas Masonite, Cabrero
                                            </td>
                                            <td style="border:1px solid black; padding:5px;">$0</td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                            Celulosa CMPC Santa Fe Nacimiento / Celulosa Arauco Nueva Aldea
                                            </td>
                                            <td style="border:1px solid black; padding:5px;">$2.040</td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                            Celulosa Horcones Arauco / Colbun Coronel / Planta Paneles Masisa Coronel
                                            </td>
                                            <td style="border:1px solid black; padding:5px;">$3.570</td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                            Celulosa Arauco Licancel, Constitucion, Teno
                                            </td>
                                            <td style="border:1px solid black; padding:5px;">$10.400</td>
                                        </tr>

                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                            Planta Valdivia
                                            </td>
                                            <td style="border:1px solid black; padding:5px;">$14.000</td>
                                        </tr>
                                    </table>
                                </t>

                                <t t-if="line.payment_concept_id.name != 'Bonos Localidad'">
                                    <li style="text-align:justify;">
                                        <strong>
                                        <span t-esc="line.payment_concept_id.name"/>:
                                        </strong>

                                        <t t-if="line.amount &gt; 0">
                                            <span t-esc="line.payment_concept_id.description"/> 
                                            <span t-esc="' ${:,.0f}'.format(line.amount).replace(',', '.')"/>
                                            .-
                                        </t>
                                        <t t-else="">
                                            <span t-esc="line.payment_concept_id.description"/>
                                        </t>
                                    </li>
                                </t>
                            </t>
                        </ul>

                        <t t-if="contract.is_por_obra">
                            <p style="margin:0;"><strong>CUARTO: Fecha de pago de las Remuneraciones y Descuentos Legales</strong></p>

                            <p style="text-align:justify;">
                            Las remuneraciones se pagaran el dia <t t-esc="'%02d' % fecha_pago_config.dia_pago if fecha_pago_config else '06'"/> del mes siguiente por iguales periodos vencidos,
                            mediante transferencia electronica, efectuando el empleador las deducciones legales.
                            Todos los pagos y beneficios en dinero se expresan en valores brutos y están afectos
                            a la imponibilidad previsional y tributaria correspondiente.
                            </p>

                            <div style="page-break-inside: avoid !important; break-inside: avoid;">
                                <p style="text-align:justify;">
                                    <strong>QUINTO:</strong>
                                    El presente contrato tendra duracion hasta el termino de la obra o faena "<strong><span t-esc="contract.tipo_obra_id.name"/></strong>".
                                    <strong><span t-esc="contract.duracion_obra"/></strong>
                                    Sin perjuicio de que el contrato terminará por la conclusión efectiva de la obra o faena.
                                    Se deja constancia que la fecha de ingreso del trabajador es<strong>
                                        <span t-esc="contract.format_date_es(contract.date_start)"/>.
                                    </strong>
                                </p>
                                <t t-call="zhr_ajustes.contract_employee_signature_operador"/>
                            </div>
                        </t>

                        <t t-else="">
                            <p style="margin:0;"><strong>CUARTO: Fecha de pago de las Remuneraciones</strong></p>

                            <p style="text-align:justify;">
                            Las remuneraciones se pagaran el dia <t t-esc="'%02d' % fecha_pago_config.dia_pago if fecha_pago_config else '06'"/> del mes siguiente por iguales periodos vencidos,
                            mediante transferencia electronica, efectuando el empleador las deducciones legales.
                            </p>

                            <p style="margin:0;"><strong>QUINTO: Descuentos Legales</strong></p>

                            <p style="text-align:justify;">
                            Todos los pagos y beneficios en dinero se expresan en valores brutos y están afectos
                            a la imponibilidad previsional y tributaria correspondiente.
                            </p>

                            <p style="margin:0;"><strong>SEXTO: Obligaciones y/o Prohibiciones</strong></p>

                            <ol style="list-style-type: lower-alpha;">
                                <li>La dedicacion exclusiva y diligente a las funciones del cargo.</li>
                                <li>Respeto irrestricto a normas internas y reglamentos de la empresa.</li>
                                <li>Mantener reserva respecto de informacion confidencial.</li>
                                <li>Prohibicion de realizar actividades para la competencia.</li>
                            </ol>

                            <div style="page-break-inside: avoid !important; break-inside: avoid;">
                                <p style="text-align:justify;">
                                    <strong>SEPTIMO:</strong>
                                    El presente contrato tendra duracion
                                    <t t-if="contract.contract_type_id.name == 'Indefinido' or not contract.date_end">
                                        por tiempo indefinido.
                                    </t>
                                    <t t-else="">
                                        hasta el <strong>
                                            <span t-esc="contract.format_date_es(contract.date_end)"/>.
                                        </strong>
                                    </t>

                                    Se deja constancia que la fecha de ingreso del trabajador es<strong>
                                        <span t-esc="contract.format_date_es(contract.employee_id.first_contract_date)"/>.
                                    </strong>
                                </p>
                                <t t-call="zhr_ajustes.contract_employee_signature_operador"/>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="contract_employee_signature_operador">
        <div style="margin-top:45px; page-break-inside: avoid !important; break-inside: avoid;">
            <table style="width:100%; border-collapse:collapse; page-break-inside: avoid !important; break-inside: avoid;">
                <tr>
                    <td style="width:50%; text-align:center; vertical-align:top;">
                        ___________________________<br/>
                        <span t-esc="contract.employee_id.name"/><br/>
                        R.U.T.: <span t-esc="contract.employee_id.identification_id or ''"/>
                    </td>
                    <td style="width:50%; text-align:center; vertical-align:top;">
                        ___________________________<br/>
                        <span t-esc="company.name"/><br/>
                        R.U.T.: <span t-esc="company.vat"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>
